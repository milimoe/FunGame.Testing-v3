{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "构建 WebUI",
      "type": "shell",
      "command": "npm.cmd run build",
      "options": {
        "cwd": "${workspaceFolder}/webui"
      },
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "build-webapi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/WebAPI/FunGame.Testing-v3.WebAPI.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "install-webui",
      "command": "npm",
      "type": "process",
      "args": [
        "install"
      ],
      "options": {
        "cwd": "${workspaceFolder}/webui"
      },
      "problemMatcher": []
    }
  ]
}